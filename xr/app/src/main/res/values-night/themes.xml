<resources>
    <style name="Base.Theme.CaptureSDKDemo" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#EAAE50</item>
        <item name="colorOnPrimary">#131820</item>
        <item name="colorSurface">#121820</item>
        <item name="android:windowBackground">#0B1016</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">#0B1016</item>
        <item name="android:navigationBarColor">#0B1016</item>
        <item name="android:windowLightStatusBar">false</item>
